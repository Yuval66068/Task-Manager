VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Public VAPID key used by the browser to subscribe to Web Push.
# This is NOT secret and is safe to expose to the frontend.
# The matching VAPID private key must never be placed here or in any
# frontend code — it belongs only in the future push-sender Edge Function.
VITE_VAPID_PUBLIC_KEY=your-public-vapid-key

# Development-only RLS verification accounts.
# Create real Supabase Auth users for these addresses and set their passwords here.
# Never commit real credentials to version control.
VITE_TEST_PARENT_A_EMAIL=parent-a@example.com
VITE_TEST_PARENT_A_PASSWORD=replace-with-strong-test-password
VITE_TEST_CHILD_A_EMAIL=child-a@example.com
VITE_TEST_CHILD_A_PASSWORD=replace-with-strong-test-password
VITE_TEST_PARENT_B_EMAIL=parent-b@example.com
VITE_TEST_PARENT_B_PASSWORD=replace-with-strong-test-password
VITE_TEST_CHILD_B_EMAIL=child-b@example.com
VITE_TEST_CHILD_B_PASSWORD=replace-with-strong-test-password
